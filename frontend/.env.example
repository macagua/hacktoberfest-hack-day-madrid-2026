# Copiá este archivo a .env.local y ajustá lo que necesites.

# true  → todo simulado (usuario, repos, colaboradores y generación del standup).
# false → usuario/repos/colaboradores salen de GitHub o del backend, y el standup del backend.
VITE_USE_MOCK=true

# Token personal de GitHub (solo para desarrollo local, scopes: repo:read / public_repo).
# Si está definido y VITE_USE_MOCK=false, el front consulta la API de GitHub directamente.
# OJO: todo lo que empieza con VITE_ termina en el bundle. Nunca lo uses en producción;
# en producción el login es OAuth y lo maneja el backend (/api/auth/github).
VITE_GITHUB_TOKEN=

# URL del backend al que el dev server reenvía /api (ej. http://localhost:8000).
VITE_API_PROXY_TARGET=
