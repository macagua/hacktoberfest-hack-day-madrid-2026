# Copiá este archivo a .env.local y ajustá lo que necesites. Nada de esto es obligatorio en local.

# Backend al que el dev server reenvía /api (por defecto, el FastAPI local en el puerto 8000).
VITE_API_PROXY_TARGET=http://localhost:8000

# URL pública del backend para el build de producción (por ejemplo, en Vercel).
# Si queda vacía, el front llama a /api en su mismo dominio.
# El backend tiene que permitir el origen del front en CORS_ORIGINS.
VITE_API_URL=

# Repo que aparece precargado en el formulario.
VITE_DEFAULT_REPO=macagua/hacktoberfest-hack-day-madrid-2026
